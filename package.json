{
  "name": "code-agent",
  "version": "1.0.0",
  "description": "Strong AI code agent for analysis, modification, and code generation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "ai",
    "agent",
    "code",
    "claude",
    "gpt"
  ],
  "author": "drcuremeplz-eng",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "openai": "^4.52.0",
    "dotenv": "^16.4.5",
    "zod": "^3.22.4",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
